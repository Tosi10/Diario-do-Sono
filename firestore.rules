rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sonoUser() {
      return get(/databases/$(database)/documents/sonoUsers/$(request.auth.uid)).data;
    }

    function isProfessional() {
      return signedIn() && sonoUser().role in ['professional', 'admin'];
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /sonoUsers/{uid} {
      allow read: if isOwner(uid)
        || (isProfessional() && resource.data.linkedProfessionalId == request.auth.uid)
        || (signedIn() && resource.data.inviteCode != null);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || (isProfessional()
            && resource.data.role == 'patient'
            && resource.data.linkedProfessionalId == request.auth.uid
            && request.resource.data.role == 'patient');
    }

    match /sonoClinic/{docId} {
      allow read: if signedIn();
      allow create, update: if isProfessional()
        && request.resource.data.professionalUid == request.auth.uid;
    }

    match /sonoPatients/{patientUid} {
      allow read: if isOwner(patientUid)
        || (isProfessional() && resource.data.professionalId == request.auth.uid)
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create: if (isProfessional() && request.resource.data.professionalId == request.auth.uid)
        || (isOwner(patientUid) && request.resource.data.status == 'pending');
      allow update: if (isProfessional() && request.resource.data.professionalId == request.auth.uid)
        || (isOwner(patientUid) && request.resource.data.status == resource.data.status);
    }

    match /sonoWeeks/{weekId} {
      allow read: if signedIn() && (
        resource == null
        || resource.data.patientUid == request.auth.uid
        || resource.data.professionalId == request.auth.uid
      );
      allow create, update: if signedIn() && (
        request.resource.data.patientUid == request.auth.uid
        || (isProfessional() && request.resource.data.professionalId == request.auth.uid)
      );
    }

    match /sonoDays/{dayId} {
      allow read: if signedIn() && (
        resource == null
        || resource.data.patientUid == request.auth.uid
        || resource.data.professionalId == request.auth.uid
      );
      allow create, update: if signedIn() && (
        request.resource.data.patientUid == request.auth.uid
        || (isProfessional() && request.resource.data.professionalId == request.auth.uid)
      );
    }

    match /sonoOcrJobs/{jobId} {
      allow read: if signedIn() && resource.data.uploadedBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uploadedBy == request.auth.uid;
      allow update: if signedIn() && resource.data.uploadedBy == request.auth.uid;
    }
  }
}
