{
  "expo": {
    "name": "Sono à Vista",
    "slug": "mapa-do-sono-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/seal.png",
    "scheme": "mapadosono",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/seal.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1ECDF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mapadosono.app"
    },
    "android": {
      "package": "com.mapadosono.app",
      "adaptiveIcon": {
        "backgroundColor": "#F1ECDF",
        "foregroundImage": "./assets/brand/seal.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/seal.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Sono à Vista precisa da galeria para enviar a foto da folha preenchida.",
          "cameraPermission": "O Sono à Vista precisa da câmera para fotografar a folha do diário."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1ECDF",
          "image": "./assets/brand/seal.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/seal.png",
          "color": "#AC665C",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d439687f-80b4-4fbb-b477-ce9d4ae3dbdc"
      }
    },
    "owner": "v6core"
  }
}
